# Self-hosted music library: yt-dlp -> beets -> /srv/music -> Navidrome.
# Notes: ~/notes/ai/music-selfhosted-navidrome.md
{
  config,
  pkgs,
  lib,
  ...
}:
let
  musicDir = "/srv/music";
  inboxDir = "/srv/music-inbox";
  navidromePort = 4533;
in
{
  # beets itself comes from home-manager (home/sergio/beets.nix), which owns its config.
  environment.systemPackages = with pkgs; [
    yt-dlp
    ffmpeg # required by `yt-dlp -x`
  ];

  services.navidrome = {
    enable = true;
    # Host is not exposed to the internet and the phone reaches it over Tailscale,
    # so just open the port. Per-interface rules on tailscale0 were unreliable here.
    openFirewall = true;
    settings = {
      Address = "0.0.0.0";
      Port = navidromePort;
      MusicFolder = musicDir;
      # Relative to MusicFolder. .m3u files generated by beets' smartplaylist
      # (home/sergio/beets.nix). Only imported once an admin user exists.
      PlaylistsPath = "playlists";
      # Renamed upstream: ScanInterval -> ScanSchedule -> Scanner.Schedule.
      Scanner.Schedule = "@every 1h";
    };
  };

  # The library must NOT live under /home: the navidrome unit sets ProtectHome = true,
  # so a MusicFolder inside /home is invisible to the service and the library stays empty.
  #
  # sergio owns both dirs (beets writes there), navidrome reads via group.
  # setgid (2775) so files created later keep the group.
  systemd.tmpfiles.rules = [
    "d ${musicDir} 2775 sergio navidrome - -"
    "d ${musicDir}/playlists 2775 sergio navidrome - -"
    "d ${inboxDir} 2775 sergio sergio - -"
  ];
}
