#!/usr/bin/env bash

set -o errexit  # exit on error
set -o nounset  # exit on unset variables
set -o pipefail # return status of last command to throw non-zero
# set -o xtrace  # debug: print commands

readonly SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage() {
    cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-v] [-f file]

Description:
    [Short description]

Options:
    -h, --help      Display help
    -v, --verbose   Enable verbose mode
    -f, --file      Path to input file
EOF
    exit 1
}

parse_params() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) usage ;;
            -v|--verbose) verbose=1 ;;
            -f|--file) file="${2-}"; shift ;;
            -e|--env) env_file="${2-}"; shift ;;
            -?*) echo "Unknown option: $1"; usage ;;
            *) break ;;
        esac
        shift
    done

    POS_ARGS=("$@")
}

cleanup() {
    [[ -d "${TMP_DIR:-}" ]] && rm -rf "$TMP_DIR"
}
trap cleanup EXIT

log() {
    local level="${1}"
    shift
    # printf "[%s] [%s] %s\n" "$(date +'%Y-%m-%dT%H:%M:%S%z')" "${level}" "$*" >&2
    printf "[%s] %s\n" "${level}" "$*" >&2
}

log_error() { log "ERROR" "$@"; exit 1; }
log_warn()  { log "WARN"  "$@"; }
log_info()  { log "INFO"  "$@"; }

check_dependencies() {
    local missing=()
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -ne 0 ]]; then
        log_error "Missing dependencies: ${missing[*]}"
    fi
}

lock() {
    LOCKFILE="/tmp/${0##*/}.lock"
    if ! exec 9>"$LOCKFILE" 2>/dev/null; then
        echo "Error: script is already executing." >&2
        exit 1
    fi
    flock -n 9 || exit 1
}

is_root() {
    if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
        error "This script must be run as root."
    fi
}

main() {
    parse_params "$@"
    # logic

    if [[ ${#POS_ARGS[@]} -lt 2 ]]; then
        echo "Error: atleast 2 positional arguments are required."
        exit 1
    fi

    arg1="${POS_ARGS[0]}"
    arg2="${POS_ARGS[1]}"

    log_warn "exiting!!"
}

main "$@"
