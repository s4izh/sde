# vim: set ft=sh :

function _set_prompt() {
    local BOLD="1;"
    local NORMAL="0;"

    local RED="31m"
    local GREEN="32m"
    local YELLOW="33m"
    local BLUE="34m"
    local MAGENTA="35m"
    local CYAN="36m"
    local WHITE="37m"

    local PROMPT_COLOR="$BOLD$GREEN"
    local GIT_COLOR="$NORMAL$YELLOW"
    local NIX_COLOR="$NORMAL$CYAN"
    local GUIX_COLOR="$NORMAL$YELLOW"

    local git_prompt_enabled="no"
    # local PROMPT_CHAR="$NORMAL$GREEN"

    PS1=""

    [[ -n "$SSH_CLIENT" ]] && PS1+="(ssh) "

    if [ "$git_prompt_enabled" == "yes" ]; then
        if git rev-parse --is-inside-work-tree &>/dev/null; then
            toplevel=$(basename $(git rev-parse --show-toplevel))
            relative=$(git rev-parse --show-prefix)
            relative=${relative%/}
            separator="/"; [ -z "$relative" ] && separator=""
            PS1+="\[\e[$PROMPT_COLOR\]$toplevel$separator$relative"
        else
            PS1+="\[\e[$PROMPT_COLOR\]\u@\h:\w"
        fi
    else
        PS1+="\[\e[$PROMPT_COLOR\]\u@\h:\w"
    fi

    if [ -n "$IN_NIX_SHELL" ]; then
        PS1+="\[\e[$NIX_COLOR\] [env]"
    elif [ -n "$GUIX_ENVIRONMENT" ]; then
        PS1+="\[\e[$GUIX_COLOR\] [env] "
    fi

    # PS1+="\[\e[$PROMPT_COLOR\]\u@\h:\w"

    # PS1+="\[\e[$PROMPT_COLOR\]\w"

    # if [ "$git_prompt_enabled" == "yes" ]; then
    #     if git rev-parse --is-inside-work-tree &>/dev/null; then
    #         branch_name=$(git symbolic-ref --short HEAD 2>/dev/null || git describe --tags --exact-match 2>/dev/null)
    #         PS1+=" \[\e[$NORMAL$GIT_COLOR\]*$branch_name\[\e[$NORMAL$PROMPT_COLOR\]"
    #     fi
    # fi

    # PS1+=" $ \e[0m"
    # PS1+="\n\[\e[$BOLD$WHITE\]$ \e[0m"
    PS1+="\n$ \e[0m"
}

# Per-host prompt color, so it is obvious which machine a shell is on.
# Priority: $SDE_PROMPT_COLOR (e.g. set in ~/.config/shell/rc.d/local.bash)
#   > the table below > a color derived from the hostname (stable per host).
# Values are basic ANSI codes (31-36) so the terminal theme maps them for
# light and dark. Red (31) is kept for root.
function _host_color()
{
    local host=${HOSTNAME%%.*}
    case "$host" in
        dell)        echo 36 ;;  # cyan
        rx)          echo 32 ;;  # green
        zen)         echo 35 ;;  # magenta
        thinkcenter) echo 33 ;;  # yellow
        *)
            # unknown host (servers, clusters...): pick one of 32-36 from a hash
            local sum
            sum=$(printf %s "$host" | cksum)
            echo $(( 32 + ${sum%% *} % 5 ))
            ;;
    esac
}
_SDE_HOST_COLOR=$(_host_color)

function _basic_prompt()
{
    ON_SPECIAL_ENV=$IN_NIX_SHELL$GUIX_ENVIRONMENT
    local color=${SDE_PROMPT_COLOR:-$_SDE_HOST_COLOR}
    [ "$EUID" -eq 0 ] && color=31
    local ssh=""
    # "(ssh)" marker, disabled: the tmux status bar shows it (tmux-host-status).
    # Uncomment to show it outside tmux too; inside tmux a pane keeps the
    # SSH_CONNECTION it was created with, so it would be stale there.
    # [ -n "$SSH_CONNECTION" ] && [ -z "$TMUX" ] && ssh="(ssh) "
    # PS1='\u@\h \w${ON_SPECIAL_ENV:+ [env]}\n\$ '
    PS1="$ssh"'\[\e['"$color"'m\]\u@\h \w${ON_SPECIAL_ENV:+ [env]}\n\[\e[37m\]\$ '
    # PS1='\[\e[32m\]\u@\h \w${ON_SPECIAL_ENV:+ [env]}\[\e[37m\]\n> '
    # PS1='\[\e[32m\]\u@\h \w${ON_SPECIAL_ENV:+ [env]}\[\e[37m\] > '
    # PS1='\[\e[32m\]\u@\h \w${ON_SPECIAL_ENV:+ [env]}\[\e[37m\] > '
    # PS1='\[\e[1m\]\u@\h \w${ON_SPECIAL_ENV:+ [env]}\n\$\[\e[0m\] '
    # PS1="\[\e[1m\]\u@\h:\w\$ \[\e[0m\]"
}


PROMPT_COMMAND=_basic_prompt
