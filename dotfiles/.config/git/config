[core]
    ; pager = delta
    editor = nvim
[init]
    defaultBranch = "main"
[diff]
    algorithm = patience
    compactionHeuristic = true
    tool = nvimdiff
[difftool "nvimdiff"]
    cmd = nvim -d $LOCAL $REMOTE -c 'wincmd w' -c 'wincmd L'
[merge]
    tool = nvimdiff4
    prompt = false
[mergetool "nvimdiff4"]
    cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[mergetool]
    keepBackup = false
[alias]
    # basics
    st = status -sb
    br = branch
    ci = commit -v
    co = checkout
    pr = "pull --rebase"
    pwd = "rev-parse --show-prefix"
    unstage = reset HEAD --

    # log
    l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lo = log --oneline
    count = !git --no-pager log --oneline | wc -l
    graph = "--paginate log --graph --oneline"

    abbrev = !bash -c 'git rev-parse --short ${1-`echo HEAD`}' -
    ack = grep -n --break --heading
    amend = commit --amend -v
    both = diff --ignore-submodules=dirty HEAD
    cp = cherry-pick

    # submodule managemente
    su = submodule update --init --recursive
    sr = submodule update --recursive --remote
    # open in editor every file that is modified (M), added (A) or unmerged (U)
    edit = !$EDITOR $(git status --short | awk '$1 ~ /^M|A|U/ {print $2}' )
    editunmerged = "!f() { git diff --name-only --diff-filter=U | xargs ${EDITOR:-vim}; }; f"

    fbr = "!git branch | fzf | xargs git checkout"
    trim = "!git branch --merged | grep -v '\\*' | grep -v 'main' | xargs -n 1 git branch -d"

    # checkpoints
    save = !git add -A && git commit -m "SAVEPOINT"
    undo = reset --soft HEAD~1

    # Usage: git panic "fix-header-experiment"
    panic = "!f() { \
        local name=\"${1:-$(date +%Y%m%d-%H%M)}\"; \
        local branch_name=\"panic-$name\"; \
        echo \"Backing up to $branch_name...\"; \
        git checkout -b \"$branch_name\"; \
        git add -A; \
        git commit -m \"PANIC SAVE: $name\" --no-verify; \
        git checkout -; \
        git reset --hard HEAD; \
        echo \"DONE: Current branch is clean. Work saved in $branch_name.\"; \
    }; f"
    unpanic = "!f() { \
        last_panic=$(git branch --list 'panic-*' --sort=-committerdate | head -n1 | sed 's/..//'); \
        if [ -n \"$last_panic\" ]; then \
            echo \"Restoring from $last_panic...\"; \
            git merge --squash \"$last_panic\"; \
            git reset; \
            git branch -D \"$last_panic\"; \
            echo \"Back to work! Your files are back to unstaged.\"; \
        else \
            echo \"No panic branches found.\"; \
        fi \
    }; f"
[fetch]
	prune = true
[pull]
    rebase = true
    prune = true
[push]
    # https://git-scm.com/docs/git-config#Documentation/git-config.txt-pushautoSetupRemote
    autoSetupRemote = true
    # push tags automatically
    followtags = true
