#!/usr/bin/env bash
# Switch /etc/hosts between variants without a nixos rebuild.
# /etc/hosts -> /etc/static/hosts -> /etc/hosts.current -> /etc/hosts.{default,focus}

set -euo pipefail
source "$HOME/.local/scripts/lib/sde.sh"

CURRENT=/etc/hosts.current

usage() { die_usage "[default|focus|toggle|status]"; }

status() {
    basename "$(readlink "$CURRENT")" | sed 's/^hosts\.//'
}

link() {
    local mode="$1"
    [ -e "/etc/hosts.$mode" ] || die "missing /etc/hosts.$mode (rebuild needed?)"
    sudo ln -sfn "/etc/hosts.$mode" "$CURRENT"
    echo "hosts -> $mode"
}

case "${1:-status}" in
    default|focus) link "$1" ;;
    toggle)
        if [ "$(status)" = "focus" ]; then
            link default
        else
            link focus
        fi
        ;;
    status) status ;;
    *) usage ;;
esac
