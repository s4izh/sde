#!/usr/bin/env bash
# ACP adapter for editors (Emacs agent-shell, Zed), on my personal login.
# Global npm install (prefix ~/.npm); update with `make npm-update` in nix/.
export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"
export CLAUDE_CODE_EXECUTABLE="$HOME/.npm/bin/claude"   # my CLI, not the SDK's bundled copy
exec "$HOME/.npm/bin/claude-agent-acp" "$@"
